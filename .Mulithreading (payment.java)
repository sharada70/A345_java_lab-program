class PaymentTask implements Runnable {

    public void run() {

        for (int i = 1; i <= 5; i++) {
            System.out.println("Payment Processing...");
        }
    }
}

public class PaymentProcess {

    public static void main(String[] args) {

        PaymentTask payment = new PaymentTask();

        Thread t = new Thread(payment);

        t.start();
    }
}
