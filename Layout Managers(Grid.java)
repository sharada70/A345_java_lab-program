
import java.awt.*;

class Grid {
    public static void main(String[] args) {
        Frame f = new Frame("Calculator");

        f.setLayout(new GridLayout(4, 4));

        String b[] = {
            "7", "8", "9", "/",
            "4", "5", "6", "*",
            "1", "2", "3", "-",
            "0", "C", "=", "+"
        };

        for (int i = 0; i < b.length; i++) {
            f.add(new Button(b[i]));
        }

        f.setSize(300, 300);
        f.setVisible(true);
    }
}
